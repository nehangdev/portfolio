{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve portfolio",
    "build": "ng build portfolio",
    "watch": "ng build portfolio --watch --configuration development",
    "test": "ng test portfolio",
    "serve:dist": "serve dist/portfolio/browser -l 4300",
    "e2e": "playwright test",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/portfolio/browser/404/index.html','dist/portfolio/browser/404.html')\"",
    "build:element": "ng build live-chart-element && node -e \"require('fs').renameSync('public/elements/main.js','public/elements/live-chart.js')\"",
    "prebuild": "npm run build:element",
    "prestart": "npm run build:element",
    "og": "node scripts/og.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/tabler-icons": "^36.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "motion": "^13.4.3",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15"
  }
}
